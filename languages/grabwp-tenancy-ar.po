#: includes/class-grabwp-tenancy-settings.php:171
msgid "Block External HTTP"
msgstr "حظر HTTP الخارجي"

#: admin/views/settings.php:146
#: includes/class-grabwp-tenancy-settings.php:174
msgid "Block all external HTTP requests from tenant sites (WP_HTTP_BLOCK_EXTERNAL). Allowlist hosts below."
msgstr "حظر جميع طلبات HTTP الخارجية من مواقع المستأجرين (WP_HTTP_BLOCK_EXTERNAL). قم بإضافة المضيفين أدناه إلى قائمة السماح."

#: admin/views/settings.php:151
