#: includes/class-grabwp-tenancy-settings.php:123
msgid "Disable Install Plugins & Themes"
msgstr "Tắt cài đặt plugin & giao diện"

#: includes/class-grabwp-tenancy-settings.php:126
msgid "Tenant admins cannot install, update or delete plugins and themes."
msgstr "Quản trị viên tenant không thể cài đặt, cập nhật hoặc xóa plugin và giao diện."

#: includes/class-grabwp-tenancy-settings.php:131
msgid "Disable Plugin & Theme File Editor"
msgstr "Tắt trình sửa tệp plugin & giao diện"

#: includes/class-grabwp-tenancy-settings.php:134
msgid "Tenant admins cannot use the built-in code editor for plugin and theme files."
msgstr "Quản trị viên tenant không thể dùng trình sửa mã tích hợp sẵn cho các tệp plugin và giao diện."

#: includes/class-grabwp-tenancy-settings.php:139
msgid "Hide Plugins Menu"
msgstr "Ẩn menu Plugin"

#: includes/class-grabwp-tenancy-settings.php:142
msgid "Removes the Plugins menu from tenant dashboards."
msgstr "Ẩn menu Plugin khỏi bảng điều khiển của tenant."

#: includes/class-grabwp-tenancy-settings.php:145
msgid "Hide Appearance Menu"
msgstr "Ẩn menu Giao diện"

#: includes/class-grabwp-tenancy-settings.php:148
msgid "Removes the Appearance menu (themes) from tenant dashboards."
msgstr "Ẩn menu Giao diện (theme) khỏi bảng điều khiển của tenant."

#: includes/class-grabwp-tenancy-settings.php:151
msgid "Hide Themes Screen"
msgstr "Ẩn trang chọn giao diện"

#: includes/class-grabwp-tenancy-settings.php:154
msgid "Tenant admins keep Customize, Menus and Widgets under Appearance but cannot browse, install or switch themes. Has no effect when Hide Appearance Menu is on."
msgstr "Quản trị viên của trang web vẫn dùng được Tùy biến, Menu và Widget trong Giao diện nhưng không thể duyệt, cài đặt hoặc đổi giao diện. Không có tác dụng khi Ẩn menu Giao diện đang bật."

