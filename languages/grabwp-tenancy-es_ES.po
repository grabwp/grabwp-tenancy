#: admin/views/partials/settings-routing.php:66
msgid "GrabWP Tenancy Pro can change the prefix and give each site a readable alias."
msgstr "GrabWP Tenancy Pro puede cambiar el prefijo y dar a cada sitio un alias legible."

#: admin/views/partials/setup-file-safety-card.php:25
#: admin/views/partials/setup-file-safety-card.php:38
msgid "Tenant file safety"
msgstr "Seguridad de archivos de los tenants"

#: admin/views/partials/setup-file-safety-card.php:26
#: admin/views/partials/system-check.php:51
msgid "OK"
msgstr "OK"

#: admin/views/partials/setup-file-safety-card.php:28
msgid "Tenant admins cannot install or edit plugin and theme code."
msgstr "Los administradores de los inquilinos no pueden instalar ni editar código de plugins y temas."

#: admin/views/partials/setup-file-safety-card.php:39
msgctxt "file safety status"
msgid "Unsafe"
msgstr "Inseguro"

#: admin/views/partials/setup-file-safety-card.php:41
msgid "Tenant admins can install or edit plugin and theme code. That code runs on this server and can read the secret keys every site shares."
msgstr "Los administradores de los tenants pueden instalar o editar código de plugins y temas. Ese código se ejecuta en este servidor y puede leer las claves secretas que comparten todos los sitios."

#. translators: %s: setting name, e.g. Disable Plugin & Theme File Editor
#: admin/views/partials/setup-file-safety-card.php:50
#, php-format
msgid "Turn on %s in Settings."
msgstr "Activa %s en Ajustes."

#. translators: 1: constant name, e.g. DISALLOW_FILE_EDIT, 2: the value false, 3: the value true
#: admin/views/partials/setup-file-safety-card.php:56
#, php-format
msgid "Code that loads before GrabWP, usually wp-config.php, sets %1$s to %2$s. Change it to %3$s or remove that line."
msgstr "Código que se carga antes de GrabWP, normalmente wp-config.php, establece %1$s en %2$s. Cámbialo a %3$s o elimina esa línea."

#. translators: 1: site ID, followed by its domain when known, 2: constant names, e.g. DISALLOW_FILE_EDIT, 3: the value false
#: admin/views/partials/setup-file-safety-card.php:84
#, php-format
msgid "A per-site override sets %2$s to %3$s for site %1$s. In that site's Overrides screen (GrabWP Pro), choose Yes or Use global setting."
msgstr "Una anulación por sitio establece %2$s en %3$s para el sitio %1$s. En la pantalla Anulaciones de ese sitio (GrabWP Pro), elige Sí o Usar ajuste global."

#: admin/views/partials/setup-file-safety-card.php:95
msgid "Open Settings"
msgstr "Abrir Ajustes"

#: admin/views/partials/setup-hosting-card.php:27
msgid "Multisite and wp-config.php"
msgstr "Multisite y wp-config.php"

#: admin/views/partials/setup-hosting-card.php:28
msgid "Secure address"
msgstr "Dirección segura"

#: admin/views/partials/setup-hosting-card.php:29
msgid "HTTPS behind a proxy"
msgstr "HTTPS detrás de un proxy"

#: admin/views/partials/setup-hosting-card.php:30
msgid "Subdomains (wildcard)"
msgstr "Subdominios (comodín)"

#: admin/views/partials/setup-hosting-card.php:69
msgid "Working..."
msgstr "Procesando..."

#: admin/views/partials/setup-hosting-card.php:70
msgid "Network error. Check again."
msgstr "Error de red. Comprueba de nuevo."

#: admin/views/partials/setup-hosting-card.php:72
msgid "Hosting setup"
msgstr "Configuración del alojamiento"

#: admin/views/partials/setup-hosting-card.php:74
msgid "✓ Ready"
msgstr "✓ Listo"

#. translators: 1: rows that need attention, 2: number of rows.
#: admin/views/partials/setup-hosting-card.php:80
#, php-format
msgid "%1$d of %2$d needs attention"
msgid_plural "%1$d of %2$d need attention"
msgstr[0] "%1$d de %2$d requiere atención"
msgstr[1] "%1$d de %2$d requieren atención"

#. translators: %d: number of sites in the Multisite network.
#: admin/views/partials/setup-hosting-card.php:100
#, php-format
msgid "This is a Multisite network with %d sites. Do not convert it: back up or move those sites first."
msgstr "Esta es una red multisitio con %d sitios. No la conviertas: haz antes una copia de seguridad o mueve esos sitios."

#: admin/views/partials/setup-hosting-card.php:105
msgid "This site still runs as WordPress Multisite. GrabWP needs regular WordPress. Remove every line below."
msgstr "Este sitio sigue funcionando como WordPress multisitio. GrabWP necesita un WordPress normal. Elimina todas las líneas siguientes."

#: admin/views/partials/setup-hosting-card.php:108
msgid "wp-config.php has settings that stop GrabWP. Remove every line below."
msgstr "wp-config.php tiene ajustes que impiden que GrabWP funcione. Elimina todas las líneas de abajo."

#: admin/views/partials/setup-hosting-card.php:111
msgid "Regular WordPress. WP_ALLOW_MULTISITE is optional cleanup."
msgstr "WordPress normal. Limpiar WP_ALLOW_MULTISITE es opcional."

#: admin/views/partials/setup-hosting-card.php:114
msgid "This site runs as regular WordPress."
msgstr "Este sitio funciona como un WordPress normal."

#: admin/views/partials/setup-hosting-card.php:120
msgid "Lines to remove by hand"
msgstr "Líneas para eliminar manualmente"

#. translators: %s: path of wp-config.php.
#: admin/views/partials/setup-hosting-card.php:126
#, php-format
msgid "In %s:"
msgstr "En %s:"

#. translators: 1: line number, 2: PHP code on that line.
#: admin/views/partials/setup-hosting-card.php:143
#, php-format
msgid "Line %1$d: %2$s"
msgstr "Línea %1$d: %2$s"

#. translators: %s: list of constant names.
#: admin/views/partials/setup-hosting-card.php:157
#, php-format
msgid "Set outside wp-config.php (for example by a host must-use plugin): %s. Ask your host to remove them."
msgstr "Definido fuera de wp-config.php (por ejemplo, mediante un plugin imprescindible del alojamiento): %s. Pide a tu proveedor de alojamiento que las elimine."

#: admin/views/partials/setup-hosting-card.php:164
msgid "Some of these lines are inside a condition or still used by other code, so GrabWP cannot remove them for you."
msgstr "Algunas de estas líneas están dentro de una condición o aún las usa otro código, por lo que GrabWP no puede eliminarlas automáticamente."

#: admin/views/partials/setup-hosting-card.php:167
msgid "GrabWP never removes these lines for you. After removing them, log in again and activate plugins that were network activated, then Check again."
msgstr "GrabWP nunca elimina estas líneas por ti. Tras eliminarlas, vuelve a iniciar sesión, activa los plugins que estaban activos para la red y vuelve a comprobarlo."

#: admin/views/partials/setup-hosting-card.php:175
msgid "Remove these settings"
msgstr "Eliminar estos ajustes"

#: admin/views/partials/setup-hosting-card.php:176
msgid "Remove the settings listed here from wp-config.php? A backup is kept in the GrabWP data folder, and you can undo this here. You may need to log in again."
msgstr "¿Eliminar de wp-config.php los ajustes listados aquí? Se guarda una copia de seguridad en la carpeta de datos de GrabWP y puedes deshacerlo aquí. Es posible que tengas que volver a iniciar sesión."

#: admin/views/partials/setup-hosting-card.php:182
msgid "Undo settings removal"
msgstr "Deshacer la eliminación de ajustes"

#: admin/views/partials/setup-hosting-card.php:183
msgid "Put the removed settings back into wp-config.php? They may stop GrabWP again."
msgstr "¿Volver a poner los ajustes eliminados en wp-config.php? Pueden impedir de nuevo que GrabWP funcione."

#: admin/views/partials/setup-hosting-card.php:198
msgid "Your site works on https, but WordPress still uses http."
msgstr "Tu sitio funciona con https, pero WordPress sigue usando http."

#: admin/views/partials/setup-hosting-card.php:201
msgid "Your site works on https, but WordPress still uses http. Fix HTTPS behind a proxy first, then open this page over https."
msgstr "Tu sitio funciona con https, pero WordPress sigue usando http. Corrige primero el HTTPS detrás de un proxy y luego abre esta página mediante https."

#: admin/views/partials/setup-hosting-card.php:204
msgid "WP_HOME or WP_SITEURL sets the address. Remove it from wp-config.php above, then Check again."
msgstr "WP_HOME o WP_SITEURL fija la dirección. Quítalo de wp-config.php arriba y luego vuelve a comprobar."

#. translators: %s: host name.
#: admin/views/partials/setup-hosting-card.php:209
#, php-format
msgid "The https certificate of %s is not valid. Ask your host or CDN for one."
msgstr "El certificado https de %s no es válido. Solicita uno a tu proveedor de alojamiento o CDN."

#. translators: %s: host name.
#: admin/views/partials/setup-hosting-card.php:216
#, php-format
msgid "%s does not answer on https yet. Turn on SSL at your host or CDN."
msgstr "%s aún no responde por https. Activa SSL en tu proveedor de alojamiento o CDN."

#: admin/views/partials/setup-hosting-card.php:221
msgid "WordPress uses https."
msgstr "WordPress usa https."

#: admin/views/partials/setup-hosting-card.php:229
msgid "Switch to https"
msgstr "Cambiar a https"

#: admin/views/partials/setup-hosting-card.php:230
msgid "Switch the WordPress Address and Site Address to https? Links inside posts are not changed. You can undo this here."
msgstr "¿Cambiar la dirección de WordPress y la dirección del sitio a https? Los enlaces dentro de las entradas no cambiarán. Puedes deshacerlo aquí."

#: admin/views/partials/setup-hosting-card.php:237
msgid "Undo"
msgstr "Deshacer"

#: admin/views/partials/setup-hosting-card.php:238
msgid "Put the WordPress Address and Site Address back to http?"
msgstr "¿Volver a poner la dirección de WordPress y la dirección del sitio en http?"

#: admin/views/partials/setup-hosting-card.php:253
msgid "Your proxy or CDN serves https, but WordPress is not told."
msgstr "Tu proxy o CDN sirve https, pero WordPress no recibe esa información."

#. translators: %d: line number in wp-config.php.
#: admin/views/partials/setup-hosting-card.php:258
#, php-format
msgid "wp-config.php has HTTPS code at line %d, but WordPress still sees http."
msgstr "wp-config.php tiene código HTTPS en la línea %d, pero WordPress sigue detectando http."

#. translators: %d: line number in wp-config.php.
#: admin/views/partials/setup-hosting-card.php:265
#, php-format
msgid "The HTTPS code at line %d of wp-config.php runs after the GrabWP loader, so new sites can miss https."
msgstr "El código HTTPS en la línea %d de wp-config.php se ejecuta después del cargador de GrabWP, por lo que los sitios nuevos pueden no detectar https."

#: admin/views/partials/setup-hosting-card.php:270
msgid "No proxy or CDN reports https for this visit."
msgstr "Ningún proxy ni CDN informa de https en esta visita."

#: admin/views/partials/setup-hosting-card.php:273
msgid "WordPress sees https from your proxy or CDN."
msgstr "WordPress detecta https desde tu proxy o CDN."

#: admin/views/partials/setup-hosting-card.php:281
msgid "Add HTTPS detection"
msgstr "Añadir detección de HTTPS"

#: admin/views/partials/setup-hosting-card.php:282
msgid "Add HTTPS detection to wp-config.php? A backup is kept in the GrabWP data folder, and you can undo this here."
msgstr "¿Añadir detección de HTTPS a wp-config.php? Se guardará una copia de seguridad en la carpeta de datos de GrabWP y podrás deshacerlo aquí."

#: admin/views/partials/setup-hosting-card.php:288
msgid "Remove HTTPS detection"
msgstr "Eliminar detección de HTTPS"

#: admin/views/partials/setup-hosting-card.php:289
msgid "Remove the HTTPS detection that GrabWP added to wp-config.php? Behind a proxy, WordPress then sees http again."
msgstr "¿Eliminar la detección de HTTPS que GrabWP añadió a wp-config.php? Detrás de un proxy, WordPress volverá a detectar http."

#: admin/views/partials/setup-hosting-card.php:296
msgid "Code to add by hand"
msgstr "Código para añadir manualmente"

#. translators: %s: the GrabWP loader marker line.
#: admin/views/partials/setup-hosting-card.php:301
#, php-format
msgid "Add to wp-config.php, before %s:"
msgstr "Añadir a wp-config.php, antes de %s:"

#: admin/views/partials/setup-hosting-card.php:309
msgid "Copy code"
msgstr "Copiar código"

#: admin/views/partials/setup-hosting-card.php:325
msgid "Not needed: sites use path addresses."
msgstr "No es necesario: los sitios usan direcciones con ruta."

#: admin/views/partials/setup-hosting-card.php:328
msgid "This site has no domain name, so sites cannot get subdomains."
msgstr "Este sitio no tiene nombre de dominio, por lo que los sitios no pueden usar subdominios."

#. translators: %s: wildcard pattern such as *.example.com
#: admin/views/partials/setup-hosting-card.php:332
#, php-format
msgid "No DNS record for %s yet. Add a wildcard record at your DNS host."
msgstr "Aún no hay ningún registro DNS para %s. Añade un registro comodín en tu proveedor de DNS."

#. translators: %s: wildcard pattern such as *.example.com
#: admin/views/partials/setup-hosting-card.php:336
#, php-format
msgid "%s has DNS, but nothing answers on https."
msgstr "%s tiene DNS, pero no hay respuesta en https."

#. translators: %s: wildcard pattern such as *.example.com
#: admin/views/partials/setup-hosting-card.php:340
#, php-format
msgid "%s reaches a different website. Point it at this site at your host."
msgstr "%s dirige a otro sitio web. Apúntalo a este sitio en tu alojamiento."

#. translators: %s: wildcard pattern such as *.example.com
#: admin/views/partials/setup-hosting-card.php:344
#, php-format
msgid "%s reaches this site, but the certificate does not cover it."
msgstr "%s llega a este sitio, pero el certificado no lo cubre."

#. translators: %s: wildcard pattern such as *.example.com
#: admin/views/partials/setup-hosting-card.php:348
#, php-format
msgid "New sites at %s work."
msgstr "Los sitios nuevos en %s funcionan."

#: admin/views/partials/setup-hosting-card.php:355
msgid "DNS"
msgstr "DNS"

#: admin/views/partials/setup-hosting-card.php:356
msgid "address"
msgstr "dirección"

#: admin/views/partials/setup-hosting-card.php:357
msgid "certificate"
msgstr "certificado"

#: admin/views/partials/setup-hosting-card.php:365
#: admin/views/partials/system-check.php:70
#: admin/views/setup-steps/check.php:70
#: admin/views/setup-steps/check.php:80
msgid "Check again"
msgstr "Comprobar de nuevo"

#: admin/views/partials/setup-hosting-card.php:370
msgid "Using xCloud?"
msgstr "¿Usas xCloud?"

#: admin/views/partials/setup-hosting-card.php:372
msgid "In xCloud, create the WordPress site as Multisite with subdomains. xCloud sets up wildcard subdomain hosting only for such sites."
msgstr "En xCloud, crea el sitio WordPress como multisitio con subdominios. xCloud solo configura el alojamiento de subdominios comodín para este tipo de sitios."

#: admin/views/partials/setup-hosting-card.php:373
msgid "Wait until the Subdomains row here passes: DNS, address and certificate."
msgstr "Espera hasta que la fila Subdominios de aquí se valide: DNS, dirección y certificado."

#: admin/views/partials/setup-hosting-card.php:374
msgid "Then remove every native Multisite line from wp-config.php. GrabWP runs only on regular WordPress (single site). Old Multisite rules in .htaccess can stay."
msgstr "Después, elimina todas las líneas nativas de multisitio de wp-config.php. GrabWP solo funciona en un WordPress normal (sitio único). Las reglas antiguas de multisitio en .htaccess pueden quedarse."

#: admin/views/partials/setup-hosting-card.php:375
msgid "If the network already has more than one site, do not convert it. Back up or move those sites first."
msgstr "Si la red ya tiene más de un sitio, no la conviertas. Haz antes una copia de seguridad o mueve esos sitios."

#. translators: %s: reason the install failed.
#: admin/views/partials/site-result.php:39
#: admin/views/setup-steps/done.php:56
#, php-format
msgid "The site was created but WordPress could not be installed automatically: %s"
msgstr "El sitio se ha creado, pero WordPress no se ha podido instalar automáticamente: %s"

#: admin/views/partials/site-result.php:46
#: admin/views/setup-steps/done.php:63
msgid "Finish install in browser"
msgstr "Terminar la instalación en el navegador"

