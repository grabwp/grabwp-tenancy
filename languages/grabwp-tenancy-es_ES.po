msgstr "Hosts separados por comas permitidos cuando el HTTP externo está bloqueado (WP_ACCESSIBLE_HOSTS). Se admiten comodines."

#: admin/views/settings.php:174
msgid "Save Settings"
msgstr "Guardar ajustes"

#: admin/views/settings.php:181
msgid "Scheduling and automatic backups"
msgstr "Programación y copias de seguridad automáticas"

#: admin/views/settings.php:182
msgid "Schedule automatic backups for each tenant site on an interval you control. Pro automatically pushes backup copies to secure offsite storage after each run, so you never lose client data to a server failure."
