msgstr "Sitio creado: %s"

#: admin/views/partials/site-result.php:64
#: admin/views/setup-steps/done.php:68
msgid "Username"
msgstr "Nombre de usuario"

#: admin/views/partials/site-result.php:66
#: admin/views/setup-steps/done.php:70
msgid "Password"
msgstr "Contraseña"

#: admin/views/partials/site-result.php:68
#: admin/views/setup-steps/done.php:72
msgid "Show"
msgstr "Mostrar"

#: admin/views/partials/site-result.php:68
#: admin/views/setup-steps/done.php:72
msgid "Hide"
msgstr "Ocultar"

#: admin/views/partials/site-result.php:69
#: admin/views/setup-steps/done.php:73
#: admin/views/tenant-edit.php:83
msgid "Copy"
msgstr "Copiar"

#: admin/views/partials/site-result.php:71
msgid "This password is shown once. You do not need it: the 1-click Admin button logs you in."
